# Copy to .env and fill in. .env is git-ignored. Names only here: never put a real key in this file.

# Required for live model calls (intent for weak/ambiguous requests, screenshots, chat)
OPENAI_API_KEY=         # a real key for live calls; any placeholder such as 'unused' reproduces output.csv from the cache
LUNA_MODEL=gpt-6-luna
SOL_MODEL=gpt-6.1-sol

# Optional
LLM_BASE_URL=            # leave empty for the provider's default endpoint
LUNA_EFFORT=high         # reasoning effort of the primary model
SOL_EFFORT=low           # reasoning effort of the escalation model
# LUNA_TEMPERATURE=      # not sent by default: the configured models reject a custom temperature (see code/ISSUES.md #2)
# SOL_TEMPERATURE=

# Used only to turn token counts into a cost estimate (USD per 1,000,000 tokens)
LUNA_PRICE_IN=
LUNA_PRICE_OUT=
SOL_PRICE_IN=
SOL_PRICE_OUT=

# Optional: public web search for the chat assistant only (never used by the audit). Leave empty to turn it off.
EXA_API_KEY=
EXA_API_URL=https://api.exa.ai/search
